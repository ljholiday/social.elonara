# Copy this file to .env and replace values for the target environment.
APP_ENV=production
APP_NAME="Elonara Social"
APP_DOMAIN=social.elonara.com
APP_URL=https://social.elonara.com
APP_DEBUG=false
ASSET_URL=/assets
APP_SUPPORT_EMAIL=support@social.elonara.com
APP_NOREPLY_EMAIL=no-reply@social.elonara.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_AUTH=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@social.elonara.com
MAIL_FROM_NAME="Elonara Social"
MAIL_REPLY_TO_ADDRESS=support@social.elonara.com
MAIL_REPLY_TO_NAME="Elonara Social Support"
MAIL_DEBUG=0

BLUESKY_OAUTH_ENABLED=false
BLUESKY_CLIENT_ID=
BLUESKY_CLIENT_SECRET=
BLUESKY_CLIENT_PRIVATE_KEY=
BLUESKY_CLIENT_KEY_ID=
BLUESKY_TOKEN_AUTH_METHOD=private_key_jwt
BLUESKY_METADATA_URL=https://bsky.social/.well-known/oauth-authorization-server
BLUESKY_CLIENT_METADATA_URL=https://social.elonara.com/oauth/oauth-client-metadata.json
BLUESKY_REDIRECT_URI=https://social.elonara.com/auth/bluesky/callback
BLUESKY_SCOPES="repo:app.bsky.feed.post blob:*/* rpc:com.atproto.repo.createRecord?aud=did:web:bsky.social"
BLUESKY_FORCE_FOR_INVITES=true
BLUESKY_ALLOW_LEGACY=true
BLUESKY_TOKEN_KEY=
