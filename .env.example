APP_ENV=local
APP_NAME="Elonara Social"
APP_DOMAIN=social.elonara.local
APP_URL=https://social.elonara.local
ASSET_URL=/assets

# Database (optional if you edit config/database.php directly)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social_elonara
DB_USER=social_elonara
DB_PASSWORD=change_me

# Mail transport for Mailpit local capture.
# SMTP: 127.0.0.1:1025
# Web UI: http://127.0.0.1:8025
MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_AUTH=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@social.elonara.local
MAIL_FROM_NAME="Elonara Social"
MAIL_REPLY_TO_ADDRESS=support@social.elonara.local
MAIL_REPLY_TO_NAME="Elonara Social Support"
MAIL_DEBUG=0
