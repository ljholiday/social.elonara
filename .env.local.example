APP_ENV=local
APP_NAME="Elonara Social"
APP_DOMAIN=social.elonara.local
APP_URL=https://social.elonara.local
ASSET_URL=/assets

# The primary app config is config/config.php.
# Keep these aligned if legacy scripts or local tooling read .env directly.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=social_elonara
DB_USER=social_elonara
DB_PASSWORD=change_me

# Mailpit local capture.
# SMTP: 127.0.0.1:1025
# Web UI: http://127.0.0.1:8025
MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_AUTH=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@social.elonara.local
MAIL_FROM_NAME="Elonara Social"
MAIL_REPLY_TO_ADDRESS=support@social.elonara.local
MAIL_REPLY_TO_NAME="Elonara Social Support"
MAIL_DEBUG=0

# Optional Bluesky OAuth local values.
BLUESKY_OAUTH_ENABLED=false
BLUESKY_CLIENT_ID=
BLUESKY_CLIENT_SECRET=
BLUESKY_CLIENT_PRIVATE_KEY=
BLUESKY_CLIENT_KEY_ID=
BLUESKY_TOKEN_AUTH_METHOD=private_key_jwt
BLUESKY_METADATA_URL=https://bsky.social/.well-known/oauth-authorization-server
BLUESKY_CLIENT_METADATA_URL=https://social.elonara.local/oauth/oauth-client-metadata.json
BLUESKY_REDIRECT_URI=https://social.elonara.local/auth/bluesky/callback
BLUESKY_SCOPES="repo:app.bsky.feed.post blob:*/* rpc:com.atproto.repo.createRecord?aud=did:web:bsky.social"
BLUESKY_FORCE_FOR_INVITES=true
BLUESKY_ALLOW_LEGACY=true
BLUESKY_TOKEN_KEY=
